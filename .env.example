# Local website defaults. Docker Compose also reads this file after copying to .env.
SJ_HOST=127.0.0.1
SJ_PORT=4175
SJ_DATA_DIR=.data
SJ_STATIC_DIR=dist-website
SJ_ALLOWED_ORIGINS=http://127.0.0.1:4175,http://localhost:4175
SJ_COOKIE_SECURE=false
# Empty means ignore forwarded IP headers. For this Compose Caddy, use only
# 172.30.41.2. Do not trust all addresses or an entire private address range.
SJ_TRUST_PROXY=

# Optional. Leave empty to let the server generate .data/setup-token.txt.
# This is a one-time setup token, not the account password. Do not commit .env.
SJ_SETUP_TOKEN=

# Compose settings. Keep this volume name to reuse your saved projects/accounts.
SJ_IMAGE=xu-jian-website:local
SJ_DATA_VOLUME=xu-jian-website-data

# Before enabling the https profile:
# 1. Set SJ_DOMAIN to your domain (without https:// or a path).
# 2. Set SJ_ALLOWED_ORIGINS=https://your-domain.example
# 3. Set SJ_COOKIE_SECURE=true
# 4. Set SJ_TRUST_PROXY=172.30.41.2 (the Caddy IP fixed in compose.yaml)
# SJ_DOMAIN=work.example.com
